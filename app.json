{
  "expo": {
    "name": "Beacon",
    "slug": "Beacon",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/ios-dark.png",
        "tinted": "./assets/ios-tinted.png"
      },
      "bundleIdentifier": "com.geoffreygx.beacon",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "blockedPermissions": ["android.permission.WRITE_SETTINGS"],
      "package": "com.geoffreygx.beacon"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Beacon utilise votre position uniquement quand vous appuyez sur « Me localiser », pour choisir l’arrêt de bus le plus proche."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Beacon utilise Face ID pour confirmer que c’est bien vous avant d’afficher votre QR code de paiement Izly."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["fr", "en", "de", "es", "it", "pt", "pl", "nl", "sv", "nb", "fi", "ar", "zh-Hans", "ja", "ko", "el", "la"],
            "android": ["fr", "en", "de", "es", "it", "pt", "pl", "nl", "sv", "nb", "fi", "ar", "zh-Hans", "ja", "ko", "el", "la"]
          }
        }
      ]
    ],
    "scheme": "beacon",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3c299c60-7d09-42b9-8cb0-362a0cfc11f0"
      }
    }
  }
}
